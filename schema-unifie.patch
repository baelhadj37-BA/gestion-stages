+import { NextRequest, NextResponse } from 'next/server';
+import { prisma } from '@/lib/prisma';
+import { verifierToken } from '@/lib/auth';
+
+// ─────────────────────────────────────────
+// GET /api/offres — Recherche et filtrage (section 3.2 du CDC)
+// Query params: ?domaine=&duree=&localisation=&tag=
+// Un étudiant ne voit que les offres PUBLIEE (déjà validées par l'admin)
+// ─────────────────────────────────────────
+export async function GET(request: NextRequest) {
+  try {
+    const { searchParams } = new URL(request.url);
+    const localisation = searchParams.get('localisation');
+    const duree = searchParams.get('duree');
+    const tag = searchParams.get('tag');
+
+    const authHeader = request.headers.get('authorization');
+    const token = authHeader?.replace('Bearer ', '');
+    const tokenData = token ? verifierToken(token) : null;
+
+    // Un admin ou une entreprise peut voir toutes les offres (y compris EN_ATTENTE) ;
+    // les autres (étudiant, visiteur) ne voient que les offres publiées.
+    const voitTout = tokenData?.role === 'ADMIN' || tokenData?.role === 'ENTREPRISE';
+
+    const offres = await prisma.offre.findMany({
+      where: {
+        ...(voitTout ? {} : { statut: 'PUBLIEE' }),
+        ...(localisation ? { localisation: { contains: localisation } } : {}),
+        ...(duree ? { duree: { contains: duree } } : {}),
+        ...(tag ? { tags: { contains: tag } } : {}),
+      },
+      include: {
+        entreprise: { select: { id: true, nom: true, secteur: true } },
+      },
+      orderBy: { createdAt: 'desc' },
+    });
+
+    return NextResponse.json(offres);
+  } catch (error) {
+    console.error('Erreur récupération offres:', error);
+    return NextResponse.json({ error: 'Erreur serveur' }, { status: 500 });
+  }
+}
+
+// ─────────────────────────────────────────
+// POST /api/offres — Publication par une entreprise (section 3.2)
+// L'offre est créée avec statut = EN_ATTENTE, en attente de validation admin
+// ─────────────────────────────────────────
+export async function POST(request: NextRequest) {
+  try {
+    const authHeader = request.headers.get('authorization');
+    const token = authHeader?.replace('Bearer ', '');
+    const tokenData = token ? verifierToken(token) : null;
+
+    if (!tokenData) {
+      return NextResponse.json({ error: 'Connexion requise' }, { status: 401 });
+    }
+    if (tokenData.role !== 'ENTREPRISE' && tokenData.role !== 'ADMIN') {
+      return NextResponse.json(
+        { error: 'Seule une entreprise peut publier une offre' },
+        { status: 403 }
+      );
+    }
+
+    const body = await request.json();
+    const { titre, description, localisation, duree, tags } = body;
+
+    if (!titre || !description || !localisation || !duree) {
+      return NextResponse.json(
+        { error: 'Veuillez remplir tous les champs obligatoires.' },
+        { status: 400 }
+      );
+    }
+
+    const nouvelleOffre = await prisma.offre.create({
+      data: {
+        titre,
+        description,
+        localisation,
+        duree,
+        tags: tags || '',
+        entrepriseId: tokenData.userId,
+        statut: 'EN_ATTENTE', // validation admin requise avant publication (3.2)
+      },
+    });
+
+    return NextResponse.json(nouvelleOffre, { status: 201 });
+  } catch (error: unknown) {
+    console.error("Erreur lors de la création de l'offre:", error);
+    const errorMessage = error instanceof Error ? error.message : String(error);
+    return NextResponse.json({ error: `Erreur serveur: ${errorMessage}` }, { status: 500 });
+  }
+}
diff --git a/app/offres/BoutonPostuler.tsx b/app/offres/BoutonPostuler.tsx
