generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ETUDIANT
  ENTREPRISE
  ENCADREUR
  ADMIN
}

enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum StatutOffre {
  EN_ATTENTE
  PUBLIEE
  FERMEE
}

enum StatutConvention {
  ETAPE_ETUDIANT
  ETAPE_ENTREPRISE
  ETAPE_ADMIN
  VALIDEE
  REJETEE
}

model User {
  id              String         @id @default(cuid())
  nom             String
  email           String         @unique
  password        String
  role            Role           @default(ETUDIANT)
  offres          Offre[]
  candidatures    Candidature[]
  stagesEtudiant  Stage[]        @relation("EtudiantStage")
  stagesEncadreur Stage[]        @relation("EncadreurStage")
  notifications   Notification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Offre {
  id           String        @id @default(cuid())
  titre        String
  entreprise   String
  description  String        @db.Text
  localisation String
  duree        String
  tags         String?
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  candidatures Candidature[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Candidature {
  id        String            @id @default(cuid())
  statut    StatutCandidature @default(EN_ATTENTE)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  offreId   String
  offre     Offre             @relation(fields: [offreId], references: [id])
  stage     Stage?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Stage {
  id            Int         @id @default(autoincrement())
  dateDebut     DateTime
  dateFin       DateTime
  note          Float?
  statut        String      @default("EN_COURS")
  createdAt     DateTime    @default(now())

  etudiant      User        @relation("EtudiantStage", fields: [etudiantId], references: [id])
  etudiantId    String
  encadreur     User        @relation("EncadreurStage", fields: [encadreurId], references: [id])
  encadreurId   String
  candidature   Candidature @relation(fields: [candidatureId], references: [id])
  candidatureId String      @unique

  journaux      JournalBord[]
  convention    Convention?
  documents     Document[]
}

model JournalBord {
  id        Int      @id @default(autoincrement())
  semaine   Int
  contenu   String   @db.Text
  statut    String   @default("EN_ATTENTE")
  dateDepot DateTime @default(now())
  alerte    Boolean  @default(false)

  stage     Stage    @relation(fields: [stageId], references: [id])
  stageId   Int
}

model Convention {
  id             Int              @id @default(autoincrement())
  statut         StatutConvention @default(ETAPE_ETUDIANT)
  pdfUrl         String?
  motifRejet     String?
  dateValidation DateTime?
  createdAt      DateTime         @default(now())

  stage          Stage            @relation(fields: [stageId], references: [id])
  stageId        Int              @unique
}

model Document {
  id             Int      @id @default(autoincrement())
  type           String
  pdfUrl         String
  dateGeneration DateTime @default(now())

  stage          Stage    @relation(fields: [stageId], references: [id])
  stageId        Int
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  lu        Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String
}