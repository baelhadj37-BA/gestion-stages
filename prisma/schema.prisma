generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ETUDIANT
  ENTREPRISE
  ENCADREUR
  ADMIN
}

enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum StatutOffre {
  EN_ATTENTE
  PUBLIEE
  FERMEE
}

enum StatutConvention {
  ETAPE_ETUDIANT
  ETAPE_ENTREPRISE
  ETAPE_ADMIN
  VALIDEE
  REJETEE
}

model User {
  id          Int      @id @default(autoincrement())
  nom         String
  prenom      String
  email       String   @unique
  motDePasse  String
  role        Role     @default(ETUDIANT)
  competences String?
  matricule   String?
  classe      String?
  secteur     String?
  filiere     String?
  telephone   String?
  createdAt   DateTime @default(now())
  cvUrl   String?
  dateNaissance  String?
  disponibilite  String?
  dureeSouhaitee String?
  domaineSouhaite String?
  villeSouhaitee String?
  niveauEtudes   String?
  photoUrl       String?

  offres          Offre[]        @relation("EntrepriseOffres")
  candidatures    Candidature[]  @relation("EtudiantCandidatures")
  stagesEtudiant  Stage[]        @relation("EtudiantStage")
  stagesEncadreur Stage[]        @relation("EncadreurStage")
  notifications   Notification[]
}

model Offre {
  id           Int         @id @default(autoincrement())
  titre        String
  description  String      @db.Text
  duree        String
  localisation String
  tags         String?
  statut       StatutOffre @default(EN_ATTENTE)
  createdAt    DateTime    @default(now())

  entrepriseId Int
  entreprise   User          @relation("EntrepriseOffres", fields: [entrepriseId], references: [id])
  candidatures Candidature[]
}

model Candidature {
  id        Int               @id @default(autoincrement())
  cvUrl     String
  lettreUrl String?
  statut    StatutCandidature @default(EN_ATTENTE)
  score     Int               @default(0)
  createdAt DateTime          @default(now())

  etudiantId Int
  etudiant   User  @relation("EtudiantCandidatures", fields: [etudiantId], references: [id])
  offreId    Int
  offre      Offre @relation(fields: [offreId], references: [id])
  stage      Stage?
}

model Stage {
  id            Int      @id @default(autoincrement())
  dateDebut     DateTime
  dateFin       DateTime
  note          Float?
  statut        String   @default("EN_COURS")
  createdAt     DateTime @default(now())

  etudiantId    Int
  etudiant      User        @relation("EtudiantStage", fields: [etudiantId], references: [id])
  encadreurId   Int
  encadreur     User        @relation("EncadreurStage", fields: [encadreurId], references: [id])
  candidatureId Int         @unique
  candidature   Candidature @relation(fields: [candidatureId], references: [id])

  journaux   JournalBord[]
  convention Convention?
  documents  Document[]
}

model JournalBord {
  id             Int       @id @default(autoincrement())
  semaine        Int
  contenu        String    @db.Text
  statut         String    @default("EN_ATTENTE")
  dateDepot      DateTime  @default(now())
  alerte         Boolean   @default(false)
  commentaire    String?   @db.Text
  dateValidation DateTime?

  stageId Int
  stage   Stage @relation(fields: [stageId], references: [id])
}

model Convention {
  id             Int              @id @default(autoincrement())
  statut         StatutConvention @default(ETAPE_ETUDIANT)
  pdfUrl         String?
  motifRejet     String?
  dateValidation DateTime?
  createdAt      DateTime         @default(now())

  stageId Int   @unique
  stage   Stage @relation(fields: [stageId], references: [id])
}

model Document {
  id             Int      @id @default(autoincrement())
  type           String
  pdfUrl         String
  uuid           String   @unique @default(uuid())
  qrCodeUrl      String?
  dateGeneration DateTime @default(now())

  stageId Int
  stage   Stage @relation(fields: [stageId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  lu        Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])
}
