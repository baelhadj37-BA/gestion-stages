generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

enum Role {
  ETUDIANT
  ENTREPRISE
  ENCADREUR
  ADMIN
}

enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum StatutOffre {
  EN_ATTENTE
  PUBLIEE
  FERMEE
}

enum StatutConvention {
  ETAPE_ETUDIANT
  ETAPE_ENTREPRISE
  ETAPE_ADMIN
  VALIDEE
  REJETEE
}

enum StatutJournal {
  EN_ATTENTE
  VALIDE
  A_CORRIGER
}

// ================= MODELS =================

model User {
  id              String          @id @default(cuid())
  nom             String
  email           String          @unique
  password        String
  role            Role            @default(ETUDIANT)
  offres          Offre[]
  candidatures    Candidature[]
  stagesEtudiant  Stage[]         @relation("EtudiantStage")
  stagesEncadreur Stage[]         @relation("EncadreurStage")
  notifications   Notification[]
  journaux        JournalDeBord[] // Ajout de la relation ici
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Offre {
  id           String        @id @default(cuid())
  titre        String
  entreprise   String
  description  String        @db.Text
  localisation String
  duree        String
  tags         String?
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  candidatures Candidature[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Candidature {
  id        String            @id @default(uuid())
  cvUrl     String
  statut    StatutCandidature @default(EN_ATTENTE)

  offreId   String
  offre     Offre             @relation(fields: [offreId], references: [id])

  userId    String?
  user      User?             @relation(fields: [userId], references: [id])

  stage     Stage?

  createdAt DateTime          @default(now())
}

model Stage {
  id            Int             @id @default(autoincrement())
  dateDebut     DateTime
  dateFin       DateTime
  note          Float?
  statut        String          @default("EN_COURS")
  createdAt     DateTime        @default(now())

  etudiant      User            @relation("EtudiantStage", fields: [etudiantId], references: [id])
  etudiantId    String
  encadreur     User            @relation("EncadreurStage", fields: [encadreurId], references: [id])
  encadreurId   String

  candidature   Candidature     @relation(fields: [candidatureId], references: [id])
  candidatureId String          @unique

  journaux      JournalDeBord[] // Mise à jour pour pointer vers JournalDeBord
  convention    Convention?
  documents     Document[]
}

model Convention {
  id             Int              @id @default(autoincrement())
  statut         StatutConvention @default(ETAPE_ETUDIANT)
  pdfUrl         String?
  motifRejet     String?
  dateValidation DateTime?
  createdAt      DateTime         @default(now())

  stage          Stage            @relation(fields: [stageId], references: [id])
  stageId        Int              @unique
}

model Document {
  id             Int      @id @default(autoincrement())
  type           String
  pdfUrl         String
  dateGeneration DateTime @default(now())

  stage          Stage    @relation(fields: [stageId], references: [id])
  stageId        Int
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Fusion des deux modèles de journal en un seul correct
model JournalDeBord {
  id          String        @id @default(uuid())
  semaine     Int
  activites   String        @db.Text
  statut      StatutJournal @default(EN_ATTENTE)
  commentaire String?       @db.Text
  alerte      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  stageId     Int?          // Corrigé : Int? pour correspondre à l'id du modèle Stage
  stage       Stage?        @relation(fields: [stageId], references: [id], onDelete: Cascade)
}