generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ETUDIANT
  ENTREPRISE
  ENCADREUR
  ADMIN
}

enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum StatutOffre {
  EN_ATTENTE
  PUBLIEE
  FERMEE
}

enum StatutConvention {
  ETAPE_ETUDIANT
  ETAPE_ENTREPRISE
  ETAPE_ADMIN
  VALIDEE
  REJETEE
}

model User {
  id          Int      @id @default(autoincrement())
  nom         String
  prenom      String
  email       String   @unique
  motDePasse  String
  role        Role
  competences String?
  matricule   String?
  classe      String?
  secteur     String?
  createdAt   DateTime @default(now())

  offres          Offre[]
  candidatures    Candidature[]
  stagesEtudiant  Stage[] @relation("EtudiantStage")
  stagesEncadreur Stage[] @relation("EncadreurStage")
  notifications   Notification[]
}

model Offre {
  id           Int         @id @default(autoincrement())
  titre        String
  description  String      @db.Text
  duree        String
  localisation String
  tags         String
  statut       StatutOffre @default(EN_ATTENTE)
  createdAt    DateTime    @default(now())

  entreprise   User          @relation(fields: [entrepriseId], references: [id])
  entrepriseId Int
  candidatures Candidature[]
}

model Candidature {
  id        Int               @id @default(autoincrement())
  cvUrl     String
  lettreUrl String?
  statut    StatutCandidature @default(EN_ATTENTE)
  score     Int               @default(0)
  createdAt DateTime          @default(now())

  etudiant     User   @relation(fields: [etudiantId], references: [id])
  etudiantId   Int
  offre        Offre  @relation(fields: [offreId], references: [id])
  offreId      Int
  stage        Stage?
}

model Stage {
  id           Int      @id @default(autoincrement())
  dateDebut    DateTime
  dateFin      DateTime
  note         Float?
  statut       String   @default("EN_COURS")
  createdAt    DateTime @default(now())

  etudiant      User        @relation("EtudiantStage", fields: [etudiantId], references: [id])
  etudiantId    Int
  encadreur     User        @relation("EncadreurStage", fields: [encadreurId], references: [id])
  encadreurId   Int
  candidature   Candidature @relation(fields: [candidatureId], references: [id])
  candidatureId Int         @unique

  journaux   JournalBord[]
  convention Convention?
  documents  Document[]
}

model JournalBord {
  id        Int      @id @default(autoincrement())
  semaine   Int
  contenu   String   @db.Text
  statut    String   @default("EN_ATTENTE")
  dateDepot DateTime @default(now())
  alerte    Boolean  @default(false)

  stage   Stage @relation(fields: [stageId], references: [id])
  stageId Int
}

model Convention {
  id             Int              @id @default(autoincrement())
  statut         StatutConvention @default(ETAPE_ETUDIANT)
  pdfUrl         String?
  motifRejet     String?
  dateValidation DateTime?
  createdAt      DateTime         @default(now())

  stage   Stage @relation(fields: [stageId], references: [id])
  stageId Int   @unique
}

model Document {
  id             Int      @id @default(autoincrement())
  type           String
  pdfUrl         String
  dateGeneration DateTime @default(now())

  stage   Stage @relation(fields: [stageId], references: [id])
  stageId Int
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  lu        Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int
}